# Copia este archivo a .env.e2e (gitignored) y llena las cuentas de prueba.
# Úsalas SOLO contra el entorno local o uno de pruebas: las pruebas responden
# cuestionarios, publican comentarios y editan el perfil (y lo restauran al final).

E2E_BASE_URL=http://localhost:3000

# Alumno inscrito al menos en un curso que tenga lecciones de video y un cuestionario.
E2E_ALUMNO_EMAIL=
E2E_ALUMNO_PASSWORD=

# Supervisor activo de una organización (sin esto se saltan sus pruebas).
E2E_SUPERVISOR_EMAIL=
E2E_SUPERVISOR_PASSWORD=

# Administrador (sin esto se saltan sus pruebas y la del cuestionario,
# que usa la API de admin para conocer las respuestas y reiniciar los intentos).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
